<Window x:Class="student_records_and_grades_system.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт студентов и оценок" Height="620" Width="920" MinHeight="520" MinWidth="760">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Учёт студентов и оценок" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Студенты" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Фамилия и имя" Margin="0,8,0,2" />
                    <TextBox x:Name="StudentNameInput" />
                    <TextBlock Text="Группа" Margin="0,8,0,2" />
                    <TextBox x:Name="GroupInput" />
                    <Button Content="Добавить студента" HorizontalAlignment="Left" Margin="0,8,0,12" Padding="12,5" Click="AddStudent_Click" />
                </StackPanel>
                <ListBox x:Name="StudentsList" DisplayMemberPath="DisplayName" SelectionChanged="StudentsList_SelectionChanged" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Оценки выбранного студента" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Предмет" Margin="0,8,0,2" />
                    <TextBox x:Name="SubjectInput" />
                    <TextBlock Text="Оценка (от 2 до 5)" Margin="0,8,0,2" />
                    <TextBox x:Name="GradeInput" />
                    <Button Content="Добавить оценку" HorizontalAlignment="Left" Margin="0,8,0,8" Padding="12,5" Click="AddGrade_Click" />
                    <TextBlock x:Name="AverageText" Text="Средний балл: -" Margin="0,0,0,8" />
                </StackPanel>
                <DataGrid x:Name="GradesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="*" />
                        <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="Учебная версия: данные хранятся только до закрытия окна." Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
